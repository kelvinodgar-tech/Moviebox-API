{
  "rewrites": [
    {
      "source": "/api/movie/:detailPath",
      "destination": "/api/movie?detailPath=:detailPath"
    },
    {
      "source": "/api/tv/:detailPath",
      "destination": "/api/tv?detailPath=:detailPath"
    },
    {
      "source": "/api/details/:detailPath",
      "destination": "/api/details?detailPath=:detailPath"
    },
    {
      "source": "/api/seasons/:detailPath",
      "destination": "/api/seasons?detailPath=:detailPath"
    },
    {
      "source": "/api/captions/:detailPath",
      "destination": "/api/captions?detailPath=:detailPath"
    },
    {
      "source": "/((?!api/|css/|js/|moviebox_scraper\\.py|index\\.html|detail\\.html|search\\.html|player\\.html|404\\.html|og-image).*)",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/moviebox_scraper.py",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-python"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"moviebox_scraper.py\""
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Range"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Content-Range, Accept-Ranges, Content-Length, Content-Disposition"
        }
      ]
    }
  ]
}